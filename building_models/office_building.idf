! AetherBMS: EnergyPlus Building Model
! Location: Denver, CO (ASHRAE Climate Zone 5B)
! Multi-Zone Office building model consisting of:
! - Zone A: Executive Suite (East Facing, high solar load in morning)
! - Zone B: Open Workspace (West Facing, high solar load in afternoon)
! - Zone C: Data Server Room (Core, insulated, high internal equipment load)

Version, 23.2;

Building,
  AetherBMS Medium Office, !- Name
  0.0,                     !- North Axis {deg}
  City,                    !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value {W}
  0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

SimulationControl,
  No,                      !- Do Zone Sizing Calculation
  No,                      !- Do System Sizing Calculation
  No,                      !- Do Plant Sizing Calculation
  Yes,                     !- Run Simulation for Sizing Periods
  Yes;                     !- Run Simulation for Weather File Run Periods

RunPeriod,
  Summer Design,           !- Name
  7,                       !- Begin Month
  15,                      !- Begin Day of Month
  7,                       !- End Month
  21,                      !- End Day of Month
  Tuesday,                 !- Day of Week for Start Day
  Yes,                     !- Use Weather File Holidays and Special Days
  Yes,                     !- Use Weather File Daylight Saving Period
  No,                      !- Apply Weekend Holiday Rule
  No,                      !- Use Weather File Rain Indicators
  No;                      !- Use Weather File Snow Indicators

Site:Location,
  Denver Stapleton CO USA, !- Name
  39.77,                   !- Latitude {deg}
  -104.87,                 !- Longitude {deg}
  -7.0,                    !- Time Zone {hr}
  1611.0;                  !- Elevation {m}

Material,
  Concrete_Block,          !- Name
  Rough,                   !- Roughness
  0.10,                    !- Thickness {m}
  0.89,                    !- Conductivity {W/m-K}
  1280.0,                  !- Density {kg/m3}
  840.0,                   !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.7,                     !- Solar Absorptance
  0.7;                     !- Visible Absorptance

Material,
  Fiberglass_Insulation,   !- Name
  MediumRough,             !- Roughness
  0.08,                    !- Thickness {m}
  0.04,                    !- Conductivity {W/m-K}
  32.0,                    !- Density {kg/m3}
  840.0,                   !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.5,                     !- Solar Absorptance
  0.5;                     !- Visible Absorptance

Material,
  Gypsum_Board,            !- Name
  MediumSmooth,            !- Roughness
  0.012,                   !- Thickness {m}
  0.16,                    !- Conductivity {W/m-K}
  800.0,                   !- Density {kg/m3}
  1090.0,                  !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.6,                     !- Solar Absorptance
  0.6;                     !- Visible Absorptance

Construction,
  Exterior_Wall,           !- Name
  Concrete_Block,          !- Outside Layer
  Fiberglass_Insulation,   !- Layer 2
  Gypsum_Board;            !- Layer 3

Construction,
  Interior_Partition,      !- Name
  Gypsum_Board,            !- Outside Layer
  Gypsum_Board;            !- Layer 2

! Zones Definitions
Zone,
  Zone_A_Executive,        !- Name
  0.0,                     !- Direction of Relative North {deg}
  0.0, 0.0, 0.0,           !- X, Y, Z Origin {m}
  1,                       !- Type
  1,                       !- Multiplier
  3.0,                     !- Ceiling Height {m}
  300.0;                   !- Volume {m3}

Zone,
  Zone_B_Workspace,        !- Name
  0.0,                     !- Direction of Relative North {deg}
  0.0, 0.0, 0.0,           !- X, Y, Z Origin {m}
  1,                       !- Type
  1,                       !- Multiplier
  3.0,                     !- Ceiling Height {m}
  900.0;                   !- Volume {m3}

Zone,
  Zone_C_DataRoom,         !- Name
  0.0,                     !- Direction of Relative North {deg}
  0.0, 0.0, 0.0,           !- X, Y, Z Origin {m}
  1,                       !- Type
  1,                       !- Multiplier
  3.0,                     !- Ceiling Height {m}
  200.0;                   !- Volume {m3}

! HVAC Controls and Thermostat templates matching our MCP system.
! The MCP Server connects to these parameters via EnergyPlus FMU/API
ThermostatSetpoint:DualSetpoint,
  OfficeSetpoints,         !- Name
  HeatingSetpointSchedule, !- Heating Setpoint Temperature Schedule Name
  CoolingSetpointSchedule; !- Cooling Setpoint Temperature Schedule Name

ScheduleTypeLimits,
  Temperature,             !- Name
  -60,                     !- Lower Limit Value {C}
  200,                     !- Upper Limit Value {C}
  Continuous;              !- Numeric Type

Schedule:Compact,
  HeatingSetpointSchedule, !- Name
  Temperature,             !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: AllDays,            !- Field 2
  Until: 24:00, 20.0;      !- Field 3 (BMS resets this dynamically)

Schedule:Compact,
  CoolingSetpointSchedule, !- Name
  Temperature,             !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: AllDays,            !- Field 2
  Until: 24:00, 24.0;      !- Field 3 (BMS resets this dynamically)

ZoneControl:Thermostat,
  Zone_A_Thermostat,       !- Name
  Zone_A_Executive,        !- Zone Name
  OfficeSetpoints;         !- Control Name

ZoneControl:Thermostat,
  Zone_B_Thermostat,       !- Name
  Zone_B_Workspace,        !- Zone Name
  OfficeSetpoints;         !- Control Name

ZoneControl:Thermostat,
  Zone_C_Thermostat,       !- Name
  Zone_C_DataRoom,         !- Zone Name
  OfficeSetpoints;         !- Control Name
